{
  "name": "@tailsurf/protocol",
  "version": "0.5.0",
  "description": "TypeScript codecs and schemas for the tail.surf public protocol",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures/rest-v1.json": "./fixtures/rest-v1.json",
    "./fixtures/v1.json": "./fixtures/v1.json"
  },
  "files": [
    "dist",
    "fixtures",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm run clean && tsc --project tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { force: true, recursive: true })\"",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s2-streamstore/tailsurf.git",
    "directory": "typescript/packages/protocol"
  },
  "homepage": "https://github.com/s2-streamstore/tailsurf/tree/main/typescript/packages/protocol#readme",
  "bugs": {
    "url": "https://github.com/s2-streamstore/tailsurf/issues"
  },
  "keywords": [
    "streaming",
    "websocket",
    "codec",
    "schema"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
